# minizep HTTP service configuration: the EnvironmentFile of deploy/systemd/minizep.service.
#
# It holds bearer tokens and credentials. Keep it root-owned with mode 600:
#   sudo install -d -m 750 /etc/minizep
#   sudo install -m 600 -o root -g root deploy/minizep.env.example /etc/minizep/minizep.env
# deploy/install.sh does exactly this when the file does not exist yet, and never
# overwrites an existing one. systemd reads it as root before starting the service, so
# the service user needs no access to it. Edit with: sudoedit /etc/minizep/minizep.env
#
# Format (systemd EnvironmentFile): one KEY=value per line; no "export", no $VAR
# expansion; a line starting with # is a comment (there are no trailing comments).
#
# A commented-out line means "use the default". An EMPTY value is not the default but an
# empty string: MINIZEP_PORT= would mean port 0, MINIZEP_TIMEZONE= fails at start.
#
# Replace every CHANGE_ME: install.sh does not enable or start the service while one is
# left. Nothing in this file is a real value; the addresses are examples.

# ---- listener --------------------------------------------------------------------------

# Addresses to listen on, comma-separated: loopback plus the host's VPN address, e.g.
# 127.0.0.1,100.64.0.10 (a Tailscale address). Never 0.0.0.0 or :: on a host with a
# public interface. An address that is not assigned yet (VPN still coming up) is retried
# with backoff instead of failing the start. Keep loopback in the list: install.sh polls
# /health there.                                                      default: 127.0.0.1
MINIZEP_HOST=127.0.0.1,CHANGE_ME

# TCP port, the same on every address.                                default: 8787
#MINIZEP_PORT=8787

# ---- authentication and sessions -------------------------------------------------------

# Bearer tokens and the memory groups each one may use, comma-separated entries of
#   <token>:<group>[|<group>...]
# The first group is the token's default, used when a request names none; a request for a
# group that is not listed is rejected. Create entries with deploy/tokens.sh (32 random
# bytes, base64url). Empty: the service refuses to start.
MINIZEP_TOKENS=

# 1 = serve requests without a token. Local development only, never on a VPN address.
#                                                                     default: unset (off)
#MINIZEP_ALLOW_ANONYMOUS=1

# An MCP session idle for this long is dropped; the client re-initializes.
#                                                          default: 1800000 (30 minutes)
#MINIZEP_SESSION_TTL_MS=1800000

# Upper bound on open MCP sessions; beyond it the one idle longest is evicted.
#                                                                     default: 256
#MINIZEP_MAX_SESSIONS=256

# ---- web UI ----------------------------------------------------------------------------

# Serve the web UI on /ui for these groups, '|'-separated (the first is its default), or *
# for every group. The UI has NO login: anyone who can reach MINIZEP_HOST can read and
# write these groups, so set it only on a private network (loopback or the VPN address,
# with the VPN ACL limiting who reaches the port). Tokens on /v1 and /mcp are unaffected.
#                                                                     default: unset (no UI)
#MINIZEP_UI_GROUPS=teamA

# Host names the UI may be opened under, comma-separated, without port. IP addresses and
# localhost always work; add e.g. the host's MagicDNS name here to use that instead.
#                                                                     default: unset
#MINIZEP_UI_HOSTS=minizep.tailnet.example

# ---- ingestion -------------------------------------------------------------------------

# Async add_memory jobs (LLM extraction) running at the same time.   default: 2
#MINIZEP_JOB_CONCURRENCY=2

# Retry failed episodes (an LLM or embedding outage) in the background this often, in
# milliseconds; 0 turns it off.                              default: 600000 (10 minutes)
#MINIZEP_RETRY_INTERVAL_MS=600000

# The background retry leaves an episode alone once it has been tried this many times;
# the MCP tool retry_failed still retries it.                         default: 3
#MINIZEP_RETRY_MAX=3

# On SIGTERM, wait this long for queued and running ingestion before exiting; episodes
# still pending are resumed at the next start. The unit's TimeoutStopSec= (150 s) must
# stay above it.                                            default: 120000 (2 minutes)
#MINIZEP_DRAIN_TIMEOUT_MS=120000

# ---- storage ---------------------------------------------------------------------------

# Postgres + pgvector. The local container from infra/postgres/setup.sh listens on
# 127.0.0.1:5433 and writes its URL, with the generated password, to
# /var/tmp/minizep-pg/url: copy it here. The service cannot read that file itself (the
# unit's PrivateTmp= hides /var/tmp). Unset or empty: in-memory graph plus a JSON
# snapshot, for a single-host trial only.
MINIZEP_DATABASE_URL=postgres://minizep:CHANGE_ME@127.0.0.1:5433/minizep

# Schema that holds the tables.                                       default: public
#MINIZEP_DB_SCHEMA=public

# Postgres connect timeout in milliseconds.                           default: 3000
#MINIZEP_DB_TIMEOUT_MS=3000

# File to read the database URL from when MINIZEP_DATABASE_URL is unset. Not visible to
# the service when it is below /tmp or /var/tmp (PrivateTmp=).
#                                                  default: /var/tmp/minizep-pg/url
#MINIZEP_PGURL_FILE=/var/tmp/minizep-pg/url

# In-memory store only: the snapshot file. Its directory must be writable inside the
# sandbox: run install.sh with --snapshot-dir <that directory>.
#                                                  default: ~/.minizep/graph.json
#MINIZEP_DB=/var/lib/minizep/graph.json

# Default group of the stdio server (dist/server/mcp.js). Not used by this service, which
# takes the default group from the token.                             default: default
#MINIZEP_GROUP=default

# ---- extraction LLM (OpenAI-compatible chat completions) -------------------------------

# Set both or neither. With neither, the key and base URL are read from the service
# user's ~/.openclaw/openclaw.json (models.providers.<MINIZEP_LLM_PROVIDER>); the unit
# keeps the home directory readable for that.                  default: unset (use the file)
#MINIZEP_LLM_BASE_URL=https://llm.example.com/v1
#MINIZEP_LLM_API_KEY=CHANGE_ME

# Chat model used for extraction.                                     default: deepseek-flash
#MINIZEP_LLM_MODEL=deepseek-flash

# Provider entry looked up in the credentials file (only when the two above are unset).
#                                                                     default: deepseek
#MINIZEP_LLM_PROVIDER=deepseek

# 1 = ask for JSON mode (response_format json_object, supported by DeepSeek and OpenAI);
# 0 for an endpoint that rejects the field.                           default: 1
#MINIZEP_LLM_JSON_MODE=1

# 1 = no usable LLM configuration is fatal at start, instead of a fallback to the offline
# mock extractor (which writes meaningless facts). The unit sets it already; keep it 1.
MINIZEP_REQUIRE_REAL_PROVIDERS=1

# IANA time zone for resolving "yesterday", "next Friday" and the like. An unknown zone
# fails the start.                                   default: the host's time zone
#MINIZEP_TIMEZONE=Asia/Shanghai

# ---- embeddings (OpenAI-compatible /v1/embeddings) -------------------------------------

# The embedding endpoint. For the cluster setup this is the gateway's embed-proxy
# (infra/embedding/) reached over the VPN, e.g. http://100.64.0.20:11435; the proxy
# follows the Slurm job rollover, so this URL never changes.
#                                                  default: http://127.0.0.1:11435
MINIZEP_EMBED_URL=http://CHANGE_ME:11435

# Model name sent to the endpoint. Also the model of the Ollama tier below.
#                                                                     default: qwen3-embed
#MINIZEP_EMBED_MODEL=qwen3-embed

# Vector size of that model. Pinned in the Postgres schema: changing the model or the
# size needs a re-index (see README).                                 default: 1024
MINIZEP_EMBED_DIMS=1024

# Bearer key sent to the embedding endpoint.                          default: local
#MINIZEP_OPENAI_EMBED_KEY=local

# Search relevance floor: a fact that shares no keyword with the query and is not on or
# next to an entity the query names is only returned when the cosine between the two
# embeddings reaches this. Calibrated for Qwen3-Embedding-0.6B; -1 turns the cut off.
#                                                                     default: 0.4
#MINIZEP_SEARCH_MIN_COSINE=0.4

# Optional second tier, tried when the endpoint above fails: an Ollama server with a
# model of the SAME dimension (vectors of another size are rejected, never mixed).
#                                                                     default: unset
#MINIZEP_OLLAMA_URL=http://127.0.0.1:11434

# Library defaults of OpenAIEmbedder when it is constructed without arguments. The
# servers pass MINIZEP_EMBED_URL and MINIZEP_EMBED_MODEL instead, so these two have no
# effect on this service.
#MINIZEP_OPENAI_EMBED_URL=http://127.0.0.1:11435
#MINIZEP_OPENAI_EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B

# ---- clients (not read by this service) ------------------------------------------------

# The stdio proxy (dist/server/stdio-proxy.js) runs next to an MCP client and reads these
# from its own environment. Listed for completeness; do not set them here.
#MINIZEP_HTTP_URL=http://127.0.0.1:8787/mcp
#MINIZEP_TOKEN=

# Never set MINIZEP_TEST_DATABASE_URL on this host: tests point it at a throwaway
# database, and this file configures the production one (see docs/DEPLOY.md).
